# Configurar IA_SERVICE_SECRET en el entorno de ejecución con el mismo valor
# usado por el backend. No exponerlo en el frontend ni versionar el valor real.
IA_SERVICE_SECRET=

# Rate limit del clasificador (por IP / X-Forwarded-For). Defaults: 60 req / 15 min.
# RATE_IA_MAX=60
# RATE_IA_WINDOW_MS=900000

# Railway suele inyectar PORT automáticamente.
PORT=5000
