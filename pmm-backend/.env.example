# Copiar a .env y completar valores. No versionar el archivo .env real.

# --- Base de datos (usar MYSQL_URL O el bloque DB_* ) ---
# MYSQL_URL=mysql://usuario:clave@host:3306/nombre_bd
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_DIALECT=mysql

# --- Autenticación y sesión ---
JWT_SECRET=
GOOGLE_CLIENT_ID=
DOMINIOS_DOCENTES=ejemplo.edu.co
# Rate limit auth (H-001). Opcional; defaults: ventana 15 min, login 10, registro/recuperación 5.
# AUTH_RATE_WINDOW_MS=900000
# AUTH_RATE_LOGIN_MAX=10
# AUTH_RATE_REGISTER_MAX=5
# AUTH_RATE_RECOVERY_MAX=5

# --- Integraciones ---
FRONTEND_URL=http://localhost:5173
IA_SERVICE_URL=http://127.0.0.1:5000
GEMINI_API_KEY=
RESEND_API_KEY=

# --- Servidor y archivos ---
PORT=3001
NODE_ENV=development
# UPLOADS_DIR=
