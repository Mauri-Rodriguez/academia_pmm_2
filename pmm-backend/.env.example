# Copiar a .env y completar valores. No versionar el archivo .env real.

# --- Base de datos (usar MYSQL_URL O el bloque DB_* ) ---
# MYSQL_URL=mysql://usuario:clave@host:3306/nombre_bd
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_DIALECT=mysql

# --- Autenticación y sesión ---
JWT_SECRET=
GOOGLE_CLIENT_ID=
DOMINIOS_DOCENTES=ejemplo.edu.co
# Rate limit auth (H-001). Opcional; defaults: ventana 15 min, login 10, registro/recuperación 5.
# AUTH_RATE_WINDOW_MS=900000
# AUTH_RATE_LOGIN_MAX=10
# AUTH_RATE_REGISTER_MAX=5
# AUTH_RATE_RECOVERY_MAX=5

# Rate limits operaciones costosas (opcionales; defaults del código).
# RATE_TUTOR_MAX=20
# RATE_UPLOAD_MAX=10
# RATE_REPORTE_MAX=5
# RATE_REPORTE_WINDOW_MS=600000

# Logging (error|warn|info|debug). Default: info
# LOG_LEVEL=info

# --- Integraciones ---
FRONTEND_URL=http://localhost:5173
# Producción (oficial): FRONTEND_URL=https://academia-pmm-2.vercel.app
# Orígenes CORS exactos (coma-separados). En producción no incluir localhost.
# CORS_ORIGINS=https://academia-pmm-2.vercel.app
IA_SERVICE_URL=http://127.0.0.1:5000
GEMINI_API_KEY=
RESEND_API_KEY=
# Sin RESEND en desarrollo: los enlaces se guardan en .local/dev-mailbox/messages.jsonl
# (ignorado por Git; no hay ruta HTTP). Consultar: type .local\dev-mailbox\messages.jsonl
# Limpiar: del .local\dev-mailbox\messages.jsonl

# --- Servidor y archivos ---
PORT=3001
NODE_ENV=development
# UPLOADS_DIR=
